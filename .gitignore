.venv/
.mvde_tmp/
__pycache__/
.pytest_cache/
salidas/
demo_mvde/
*.duckdb
*.duckdb.wal
.env

# Despliegue en servidor: credenciales y datos del cliente nunca se versionan.
# Se excluye el CONTENIDO, no la carpeta: con `secretos/` git ni entra a
# mirarla y el `!` de abajo no puede reincluir nada.
secretos/*
!secretos/usuarios.txt.ejemplo
datos/*
!datos/.gitkeep
.env

# Videos: pesan y se generan con assets/video/build_video.py. Se ignoran en los
# DOS lugares — se montan en assets/video/ y se copian a landing/video/ —, que
# es lo que este .gitignore no cubría y dejó seis MP4 entrando al repo.
landing/video/*.mp4
assets/video/*.mp4
assets/video/audio/

# Artefactos de la construcción del instalador de Windows
# (packaging/preparar_runtime.ps1 y el .iss). Pesan cientos de MB: son el
# runtime embebido con todas las dependencias adentro, más el .exe compilado.
dist_app/
dist_instalador/
